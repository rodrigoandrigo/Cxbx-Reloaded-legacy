<Page
    x:Class="Cxbx_R_uwp.DirectXPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Background="#050A12">

  <SwapChainPanel x:Name="swapChainPanel">
    <Grid x:Name="chromeGrid" Padding="32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="CXBX-RELOADED" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="UWP · BACKEND D3D11" Foreground="#55D6BE"
                   FontSize="13" CharacterSpacing="140"/>
      </StackPanel>

      <Pivot x:Name="mainPivot" Grid.Row="1" Margin="0,18,0,20">
        <PivotItem Header="Biblioteca">
          <Border Background="#CC101A2A" CornerRadius="8" Padding="36">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="760">
              <TextBlock Text="Biblioteca" FontSize="15" Foreground="#8FA7C2"/>
              <TextBlock Text="Escolha um jogo Xbox" FontSize="32" FontWeight="SemiBold"
                         Margin="0,8,0,8"/>
              <TextBlock x:Name="selectedGameText"
                         Text="Nenhum arquivo ou pasta autorizado"
                         TextWrapping="Wrap" Foreground="#B9C6D6" Margin="0,0,0,22"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Abrir XBE / XISO" Click="OpenGameFile_Click"
                        Padding="18,12" Margin="0,0,10,0"/>
                <Button Content="Abrir pasta" Click="OpenGameFolder_Click" Padding="18,12"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button x:Name="startButton" Content="Iniciar emulação"
                        Click="StartButton_Click" Padding="20,13"
                        Background="#168B76" IsEnabled="False"/>
                <Button x:Name="pauseButton" Content="Pausar" Click="PauseButton_Click"
                        Padding="18,13" Margin="10,0,0,0" IsEnabled="False"/>
                <Button x:Name="stopButton" Content="Parar" Click="StopButton_Click"
                        Padding="18,13" Margin="10,0,0,0" IsEnabled="False"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </PivotItem>

        <PivotItem Header="Log">
          <Border Background="#CC101A2A" CornerRadius="8" Padding="24">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Log do aplicativo" FontSize="20" FontWeight="SemiBold"/>
              <ScrollViewer Grid.Row="1" Margin="0,16,0,14"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="logText"
                           Text="O log será gravado em LocalFolder\CxbxR\CxbxR.log."
                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
              </ScrollViewer>
              <Button Grid.Row="2" Content="Atualizar log" Click="RefreshLog_Click"
                      HorizontalAlignment="Right" Padding="18,10"/>
            </Grid>
          </Border>
        </PivotItem>

        <PivotItem Header="Configurações">
          <Border x:Name="settingsPanel" Background="#CC101A2A" CornerRadius="8" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Configurações" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="As opções são salvas em ApplicationData.LocalSettings e aplicadas sem reiniciar o aplicativo."
                           Foreground="#8FA7C2" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="Vídeo" Foreground="#55D6BE" Margin="0,24,0,8"/>
                <ComboBox x:Name="renderScaleCombo" Header="Escala de renderização" SelectedIndex="0"
                          Width="420" HorizontalAlignment="Left">
                  <ComboBoxItem Content="1x (nativa)"/>
                  <ComboBoxItem Content="2x"/>
                  <ComboBoxItem Content="3x"/>
                  <ComboBoxItem Content="4x"/>
                  <ComboBoxItem Content="5x"/>
                  <ComboBoxItem Content="6x"/>
                  <ComboBoxItem Content="7x"/>
                  <ComboBoxItem Content="8x"/>
                  <ComboBoxItem Content="9x"/>
                  <ComboBoxItem Content="10x"/>
                  <ComboBoxItem Content="11x"/>
                  <ComboBoxItem Content="12x"/>
                </ComboBox>
                <CheckBox x:Name="vsyncCheck" Content="Sincronização vertical" IsChecked="True" Margin="0,12,0,0"/>
                <CheckBox x:Name="aspectCheck" Content="Manter proporção da imagem" IsChecked="True"/>
                <CheckBox x:Name="linearFilteringCheck" Content="Filtragem linear na apresentação" IsChecked="True"/>
                <TextBlock Text="O adaptador D3D11 é escolhido pelo Windows; WARP é usado automaticamente se a GPU não puder ser criada."
                           Foreground="#8FA7C2" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="Áudio" Foreground="#55D6BE" Margin="0,22,0,8"/>
                <Slider x:Name="volumeSlider" Header="Volume" Minimum="0" Maximum="100" Value="100"
                        Width="420" HorizontalAlignment="Left"/>
                <CheckBox x:Name="muteUnfocusedCheck" Content="Silenciar quando o aplicativo perder o foco" IsChecked="True"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                  <CheckBox x:Name="pcmCodecCheck" Content="PCM" IsChecked="True" Margin="0,0,20,0"/>
                  <CheckBox x:Name="xadpcmCodecCheck" Content="Xbox ADPCM" IsChecked="True" Margin="0,0,20,0"/>
                  <CheckBox x:Name="unknownCodecCheck" Content="Codecs desconhecidos" IsChecked="True"/>
                </StackPanel>
                <TextBlock Text="Entrada" Foreground="#55D6BE" Margin="0,22,0,8"/>
                <Grid Width="620" HorizontalAlignment="Left">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <ComboBox x:Name="port1Combo" Header="Porta 1" SelectedIndex="1"><ComboBoxItem Content="Desconectado"/><ComboBoxItem Content="Controle físico 1"/><ComboBoxItem Content="Controle físico 2"/><ComboBoxItem Content="Controle físico 3"/><ComboBoxItem Content="Controle físico 4"/></ComboBox>
                    <ComboBox x:Name="port2Combo" Header="Porta 2" SelectedIndex="0" Margin="0,8,0,0"><ComboBoxItem Content="Desconectado"/><ComboBoxItem Content="Controle físico 1"/><ComboBoxItem Content="Controle físico 2"/><ComboBoxItem Content="Controle físico 3"/><ComboBoxItem Content="Controle físico 4"/></ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <ComboBox x:Name="port3Combo" Header="Porta 3" SelectedIndex="0"><ComboBoxItem Content="Desconectado"/><ComboBoxItem Content="Controle físico 1"/><ComboBoxItem Content="Controle físico 2"/><ComboBoxItem Content="Controle físico 3"/><ComboBoxItem Content="Controle físico 4"/></ComboBox>
                    <ComboBox x:Name="port4Combo" Header="Porta 4" SelectedIndex="0" Margin="0,8,0,0"><ComboBoxItem Content="Desconectado"/><ComboBoxItem Content="Controle físico 1"/><ComboBoxItem Content="Controle físico 2"/><ComboBoxItem Content="Controle físico 3"/><ComboBoxItem Content="Controle físico 4"/></ComboBox>
                  </StackPanel>
                </Grid>
                <Slider x:Name="deadzoneSlider" Header="Zona morta dos analógicos (%)" Minimum="0" Maximum="40" Value="12" StepFrequency="1" Width="420" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <CheckBox x:Name="ignoreUnfocusedInputCheck" Content="Ignorar entrada quando o aplicativo perder o foco" IsChecked="True"/>

                <TextBlock Text="Rede" Foreground="#55D6BE" Margin="0,22,0,8"/>
                <ComboBox x:Name="networkModeCombo" Header="Adaptador Xbox" SelectedIndex="1" Width="420" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Desativado"/>
                  <ComboBoxItem Content="Cabo virtual isolado"/>
                </ComboBox>
                <TextBlock Text="O sandbox UWP não expõe pcap. O cabo virtual mantém o NVNet ativo sem acessar interfaces de rede do sistema."
                           Foreground="#8FA7C2" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>

                <TextBlock Text="Sistema e compatibilidade" Foreground="#55D6BE" Margin="0,22,0,8"/>
                <ComboBox x:Name="consoleTypeCombo" Header="Tipo de console" SelectedIndex="0" Width="420" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Automático"/><ComboBoxItem Content="Retail"/><ComboBoxItem Content="Devkit"/><ComboBoxItem Content="Chihiro"/>
                </ComboBox>
                <CheckBox x:Name="ignoreSignatureCheck" Content="Ignorar assinatura XBE inválida" IsChecked="False" Margin="0,10,0,0"/>
                <CheckBox x:Name="ignoreSecurityCheck" Content="Ignorar flags de segurança XBE inválidas" IsChecked="False"/>
                <CheckBox x:Name="useAllCoresCheck" Content="Permitir threads auxiliares em todos os núcleos" IsChecked="True"/>
                <CheckBox x:Name="skipRdtscCheck" Content="Não aplicar correções RDTSC" IsChecked="False"/>
                <CheckBox x:Name="disablePixelShadersCheck" Content="Desativar pixel shaders (hack de compatibilidade)" IsChecked="False"/>

                <TextBlock Text="Diagnóstico" Foreground="#55D6BE" Margin="0,22,0,8"/>
                <CheckBox x:Name="popupCheck" Content="Mostrar falhas também na barra de status" IsChecked="True" Margin="0,10,0,0"/>
                <CheckBox x:Name="fpsOverlayCheck" Content="Exibir contador de quadros" IsChecked="False"/>
                <CheckBox x:Name="buildOverlayCheck" Content="Exibir identificação da compilação" IsChecked="False"/>
                <CheckBox x:Name="statsOverlayCheck" Content="Exibir estado HLE/LLE" IsChecked="False"/>
                <CheckBox x:Name="titleOverlayCheck" Content="Exibir título selecionado" IsChecked="False"/>
                <CheckBox x:Name="fileOverlayCheck" Content="Exibir caminho do arquivo" IsChecked="False"/>

                <TextBlock Text="Sempre ativos neste porte: JIT x86→x64, NV2A/D3D11, MCPX/APU, USB/XID e armazenamento brokered. Console Win32, processo filho, registro e adaptadores pcap/DirectSound não são usados."
                           Foreground="#8FA7C2" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                  <Button Content="Salvar e aplicar" Click="SaveSettingsButton_Click" Background="#168B76" Padding="18,10"/>
                  <Button Content="Restaurar padrões" Click="ResetSettingsButton_Click" Margin="10,0,0,0" Padding="18,10"/>
                  <Button Content="Voltar à biblioteca" Click="SettingsButton_Click" Margin="10,0,0,0" Padding="18,10"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </PivotItem>
      </Pivot>

      <Border Grid.Row="2" Background="#B30B1422" CornerRadius="5" Padding="14,10">
        <Grid>
          <TextBlock x:Name="statusText" Text="Inicializando armazenamento brokered…"
                     TextWrapping="Wrap" Margin="0,0,300,0"/>
          <TextBlock Text="WindowsApp · sem console · sem processo filho"
                     HorizontalAlignment="Right" Foreground="#73869C"/>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="emulationOverlay" Visibility="Collapsed" Background="#A0000000"
            CornerRadius="4" Padding="10,7" Margin="14"
            HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
      <StackPanel>
        <TextBlock x:Name="overlayFpsText" Visibility="Collapsed" FontFamily="Consolas" FontSize="12"/>
        <TextBlock x:Name="overlayBuildText" Text="Cxbx-Reloaded UWP · x64 · D3D11" Visibility="Collapsed" FontFamily="Consolas" FontSize="12"/>
        <TextBlock x:Name="overlayStatsText" Text="JIT x86→x64 · LLE NV2A/APU/USB" Visibility="Collapsed" FontFamily="Consolas" FontSize="12"/>
        <TextBlock x:Name="overlayTitleText" Visibility="Collapsed" FontFamily="Consolas" FontSize="12"/>
        <TextBlock x:Name="overlayFileText" Visibility="Collapsed" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxWidth="900"/>
      </StackPanel>
    </Border>
  </SwapChainPanel>
</Page>
